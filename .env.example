# Copy this file to .env before starting the project.

# PostgreSQL database used by the FastAPI backend.
POSTGRES_DB=hydrosentinel
POSTGRES_USER=malo
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# SQLAlchemy connection string consumed by the backend service.
DATABASE_URL=postgresql://malo:change-me@localhost:5433/hydrosentinel

# FastAPI application settings.
PROJECT_NAME=HydroSentinel API
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# JWT authentication settings.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Initial admin account seeded on backend startup.
ADMIN_EMAIL=admin@hydrosentinel.co.za
ADMIN_PASSWORD=admin123
# Optional: if you already have a pre-hashed password from SQL setup, set it here.
ADMIN_PASSWORD_HASH=

# Offline-trained XGBoost model location.
MODEL_PATH=/app/backend/ai/model.pkl

# OpenAI API key used for AI summaries, CAP drafts, the query agent and the cached digest.
# Without it, AI endpoints return 503 and every non-AI feature keeps working.
OPENAI_API_KEY=your-key-here

# Frontend environment variables passed to Vite.
VITE_API_URL=http://localhost:8000

# optional email for ticket notifications (leave SMTP_HOST empty to keep notifications inside the app)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@hydrosentinel.co.za
# true = create the demo contractors and their logins at start. false (default) = never. turn off for any real deployment
SEED_DEMO_DATA=true
# password for the seeded demo contractor logins and the Ekurhuleni-only demo admin (demo data only)
DEMO_CONTRACTOR_PASSWORD=contractor123

# scores every authority again when its latest score is older than this many hours (0 = off, scores change only when an admin presses Score risk now)
RESCORE_INTERVAL_HOURS=24
