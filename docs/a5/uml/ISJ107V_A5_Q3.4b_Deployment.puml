@startuml
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName Helvetica
title HydroSentinel: Deployment Diagram (presenter laptop, no cloud hosting)

node "Presenter laptop (macOS)" {
  node "Web browser" {
    artifact "React SPA\nVite :5173" as SPA
  }
  node "Python 3.12 virtual environment" {
    artifact "FastAPI app\nuvicorn :8000" as API
    artifact "ai/model.pkl\n(XGBoost)" as MODEL
    artifact "regulatory PDFs\n(TF-IDF index)" as RAG
    artifact "data/uploads/\n(report photos)" as UP
  }
  database "PostgreSQL 16 :5432\nWSA, CitizenReport,\nReportAssignment, AuditLog" as DB
}
node "Docker Compose alternative" {
  node "db (postgres:15)" as CDB
  node "backend (uvicorn)" as CAPI
  node "frontend (node:20-alpine)" as CFE
}
cloud "OpenAI API (GPT-4o)" as OAI
cloud "SMTP server (optional)" as SMTP
cloud "OpenStreetMap (map tiles)" as OSM

SPA --> API : HTTP/JSON, Bearer JWT
API --> DB : SQLAlchemy
API --> MODEL : joblib load at start
API --> RAG : in memory
API --> UP : file write
API --> OAI : HTTPS, key from .env
API ..> SMTP : only if SMTP_HOST set
SPA --> OSM : map tiles
CFE --> CAPI
CAPI --> CDB
@enduml
