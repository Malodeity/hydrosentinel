@startuml
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName Helvetica
skinparam componentStyle rectangle
top to bottom direction
skinparam nodesep 30
skinparam ranksep 45
title HydroSentinel: Component Diagram

package "Front end (React 18, Vite)" {
  component "Pages\nDashboardPage, ReportPage,\nAdminPage, ContractorTicketsPage,\nNotificationBell" as Pages
  component "api/client.ts\n(axios, JWT, refresh)" as Client
}
package "Back end (FastAPI)" {
  component "Routers\nroutes/reports.py, routes/assignments.py,\nroutes/risk.py, routes/ai.py, routes/auth.py,\nroutes/wsa.py, routes/alerts.py,\nroutes/audit.py, routes/users.py" as Routers
  component "Services\napp/auth.py, app/assignment_helpers.py,\napp/alert_helpers.py, app/audit_helpers.py,\napp/rate_limit.py, app/mailer.py,\napp/scheduler.py" as Services
  component "AI modules\nai/predict.py (XGBoost + heuristic),\nai/rag.py, ai/query_agent.py" as AI
  component "app/models.py\n(SQLAlchemy)" as Models
}
database "PostgreSQL" as DB
folder "data/uploads\n(photos)" as Up
artifact "ai/model.pkl" as Model
cloud "OpenAI API\n(GPT-4o)" as OAI
cloud "SMTP server\n(optional)" as Smtp

Pages --> Client
Client --> Routers : HTTP/JSON, Bearer JWT
Routers --> Services : use
Routers --> AI : predict, retrieve, ask
Services --> Routers : scheduler calls record_score
Routers --> Models
Services --> Models
Models --> DB : SQLAlchemy
Routers --> Up : photos
AI --> Model : load at startup
Routers --> OAI : HTTPS, key from .env
Services --> Smtp : only if SMTP_HOST is set
@enduml
