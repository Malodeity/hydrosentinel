@startuml
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
left to right direction
skinparam nodesep 22
skinparam ranksep 60
hide empty methods
title HydroSentinel: Class Diagram

class WSA {
  id : UUID
  name : String
  province : String
  blue_drop_score : Float
  nrw_percent : Float
  maint_pct : Float
  cap_status : CAPStatus
  cap_due_date : Date
  risk_level : RiskLevel
  lat : Float
  lng : Float
}
class CitizenReport {
  id : UUID
  issue_type : IssueType
  description : String
  reference_code : String
  case_status : String
  admin_comment : String
  contact_email : String
  lat : Float
  lng : Float
  resolved_at : DateTime
}
class ReportAssignment {
  id : UUID
  status : String
  instructions : String
  due_at : DateTime
  contractor_note : String
  admin_note : String
  fixed_at : DateTime
  closed_at : DateTime
}
class Contractor {
  id : UUID
  name : String
  contact_name : String
  phone : String
  email : String
  is_active : Boolean
}
class ContractorCoverage {
  issue_types : String
}
class User {
  id : UUID
  email : String
  hashed_password : String
  role : UserRole
  is_active : Boolean
  wsa_id : UUID
  contractor_id : UUID
}
class RiskScoreHistory {
  risk_level : RiskLevel
  probability : Float
  model_source : ModelSource
  model_version : String
  scored_by : UUID
  scored_at : DateTime
}
class Alert {
  alert_type : AlertType
  message : String
  acknowledged_at : DateTime
}
class AuditLog {
  action : AuditAction
  table_name : String
  old_value : JSON
  new_value : JSON
  created_at : DateTime
}
class RiskModel <<service>> {
  predict_wsa_risk()
}
class AiService <<service>> {
  call_openai()
  get_cap_draft()
  run_query_agent()
}
class AlertService <<service>> {
  raise_high_risk_alert()
  raise_report_volume_spike_alert()
  raise_geo_cluster_alert()
  raise_assignment_overdue_alerts()
}
class TicketRules <<service>> {
  can_serve()
  notify()
  public_repair_status()
}
class AuditService <<service>> {
  write_audit()
}

CitizenReport "0..*" --> "1" WSA : about
ReportAssignment "0..*" --> "1" CitizenReport : ticket for
ReportAssignment "0..*" --> "1" Contractor : worked by
ReportAssignment "0..*" --> "0..1" User : assigned by
ContractorCoverage "0..*" --> "1" Contractor : set up for
ContractorCoverage "0..*" --> "1" WSA : covers
User "0..*" --> "0..1" Contractor : works for
User "0..*" --> "0..1" WSA : limited to
Alert "0..*" --> "1" WSA : raised for
RiskScoreHistory "0..*" --> "1" WSA : scores
AuditLog "0..*" --> "0..1" User : done by
RiskModel ..> WSA : reads
RiskModel ..> RiskScoreHistory : results saved as
AiService ..> WSA : reads
AlertService ..> Alert : creates
TicketRules ..> ReportAssignment : checks
AuditService ..> AuditLog : writes
@enduml
