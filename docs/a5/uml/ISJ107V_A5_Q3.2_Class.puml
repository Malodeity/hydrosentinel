@startuml
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
left to right direction
skinparam nodesep 25
skinparam ranksep 60
hide empty methods
title HydroSentinel: Class Diagram (generated from backend/app/models.py)

class WSA {
  name
  province
  blue_drop_score
  nrw_percent
  maint_pct
  cap_status
  risk_level
  lat
  lng
}
class CitizenReport {
  issue_type
  description
  reference_code
  case_status
  admin_comment
  lat
  lng
  created_at
  resolved_at
}
class User {
  email
  hashed_password
  role
  is_active
  wsa_id
  contractor_id
  last_login_at
}
class Contractor {
  name
  contact_name
  phone
  email
  is_active
}
class ContractorCoverage {
  contractor_id
  wsa_id
  issue_types
}
class ReportAssignment {
  status
  instructions
  due_at
  contractor_note
  rejected_reason
  admin_note
  accepted_at
  started_at
  fixed_at
  closed_at
}
class Notification {
  title
  body
  assignment_id
  read_at
  created_at
}
class Alert {
  alert_type
  message
  acknowledged_at
  created_at
}
class RiskScoreHistory {
  risk_level
  probability
  model_source
  model_version
  scored_at
}
class AuditLog {
  action
  table_name
  record_id
  old_value
  new_value
  ip_address
  created_at
}
class RefreshToken {
  token_hash
  expires_at
  revoked_at
}
class Summary {
  content
  generated_at
}
enum UserRole {
  admin
  viewer
  contractor
}
enum IssueType {
  leak
  outage
  quality
  billing
}
enum AlertType {
  risk_level_high
  risk_level_increased
  report_volume_spike
  cap_overdue
  geo_cluster_incident
  assignment_overdue
}
enum ModelSource {
  xgboost
  heuristic
}
enum CAPStatus {
  none
  submitted
  in_progress
  completed
}
enum RiskLevel {
  low
  medium
  high
}

CitizenReport "*" --> "1" WSA : about
ReportAssignment "*" --> "1" CitizenReport : ticket for
ReportAssignment "*" --> "1" Contractor : worked by
ReportAssignment "*" --> "0..1" User : assigned by
ContractorCoverage "*" --> "1" Contractor
ContractorCoverage "*" --> "1" WSA : covers
User "*" --> "0..1" Contractor : works for
User "*" --> "0..1" WSA : limited to
Notification "*" --> "1" User : for
Notification "*" --> "0..1" ReportAssignment : about
Alert "*" --> "1" WSA : raised for
RiskScoreHistory "*" --> "1" WSA : scores
AuditLog "*" --> "0..1" User : done by
RefreshToken "*" --> "1" User : session of
User ..> UserRole : role
CitizenReport ..> IssueType : issue_type
Alert ..> AlertType : alert_type
RiskScoreHistory ..> ModelSource : model_source
WSA ..> CAPStatus : cap_status
WSA ..> RiskLevel : risk_level
@enduml
