@startuml
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName Helvetica
title HydroSentinel: Sequence Diagram, draft a ticket with AI, repair it and verify it

actor Admin
actor Contractor
boundary "React UI\n(AdminPage,\nContractorTicketsPage)" as UI
control "FastAPI\n(routes/ai.py,\nroutes/assignments.py)" as API
participant "GPT-4o\n(OpenAI API)" as AI
database "PostgreSQL" as DB

Admin -> UI : Open a report, press Draft with AI
UI -> API : GET /ai/reports/{report_id}/work-order (Bearer JWT)
alt over 20 AI requests this hour
  API --> UI : 429
else within limit
  API -> DB : load report, authority, contractors set up for it
  alt OpenAI works
    API -> AI : structured prompt (30 s timeout)
    AI --> API : instructions + suggested contractor
  else no key or OpenAI failure
    API -> API : use template text
  end
  API --> UI : 200 draft
end
Admin -> UI : Edit the draft, press Assign
UI -> API : POST /reports/{report_id}/assign
alt another admin assigned it first
  API --> UI : 409
else assigned
  API -> DB : INSERT ReportAssignment, Notification, AuditLog
  API --> UI : 201 ticket
end
Contractor -> UI : Accept, start, mark fixed with a note
UI -> API : PATCH /my/tickets/{assignment_id}
alt step out of order or no note
  API --> UI : 409 / 422
else allowed
  API -> DB : UPDATE ReportAssignment (fixed), Notification to admins
  API --> UI : 200 (report stays in review)
end
Admin -> UI : Check the work, press Verify
UI -> API : PATCH /assignments/{assignment_id}/review
API -> DB : close ticket, resolve CitizenReport, INSERT AuditLog
API --> UI : 200
UI --> Admin : Report is resolved
@enduml
